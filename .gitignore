# ---------------------------------------------------------------------------
# LogiMind .gitignore
# Track source code, documentation, tests, and curated sample fixtures only.
# Local environments, secrets, generated artifacts, and large datasets are
# intentionally excluded.
# ---------------------------------------------------------------------------

# Environment secrets (the template must stay tracked)
.env
.env.*
!.env.example
*.env

# Python bytecode and packaging artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
develop-eggs/
downloads/
eggs/
parts/
sdist/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Test, type-checker, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml

# Node.js / frontend build output (frontend is planned, not implemented)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/
.next/
.nuxt/
out/
.cache/
.vite/
coverage/

# Databases and local storage (never commit runtime data)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Local data scratchpads (keep only curated fixtures under data/samples/)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Curated fixtures under data/samples/ remain trackable
!data/samples/

# Operating-system metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs and editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# Logs and temporary files
*.log
logs/
tmp/
temp/
