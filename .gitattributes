# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.md text
*.txt text
*.py text diff=python
*.js text
*.ts text
*.tsx text
*.jsx text
*.json text
*.yml text
*.yaml text
*.sql text
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
