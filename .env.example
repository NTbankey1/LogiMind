# LogiMind Environment Variables Example
# Copy this file to .env and adjust values for local development.
# NEVER commit your actual .env file or real secrets to Git.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration (Proposed)
PORT=8000
HOST=127.0.0.1

# Database Configuration (Proposed SQLite)
DATABASE_URL=sqlite:///./data/logimind.db

# Solver Configuration (Proposed)
SOLVER_TIMEOUT_SECONDS=60
SOLVER_NAME=CBC
